const SH={to:"M28 18 L6 36 L16 52 L28 45 L28 98 L72 98 L72 45 L84 52 L94 36 L72 18 Q50 31 28 18Z",tb:"M32 20 L14 34 L21 47 L32 42 L32 96 L68 96 L68 42 L79 47 L86 34 L68 20 Q50 29 32 20Z",mo:"M26 28 L6 72 L18 78 L28 54 L28 102 L72 102 L72 54 L82 78 L94 72 L74 28 Q66 14 50 14 Q34 14 26 28Z",ca:"M30 14 H70 L77 110 H56 L50 46 L44 110 H23Z",be:"M30 22 H70 L79 82 H54 L50 48 L46 82 H21Z",bo:"M20 72 Q20 36 52 36 Q82 36 82 72Z M76 66 Q98 66 99 76 L68 76Z",ac:"M24 42 H76 V106 H24Z"};
const DT={mo:"M36 80 H64 L60 94 H40Z M38 22 Q50 42 62 22",ca:"M27 54 h9 v13 h-9z M64 54 h9 v13 h-9z",ac:"M36 42 Q36 16 50 16 Q64 16 64 42",be:"M26 52 h9 v12 h-9z M65 52 h9 v12 h-9z"};
const R=v=>v.toLocaleString("pt-BR",{style:"currency",currency:"BRL"});
const pp=p=>p.promo||p.preco, byId=id=>D.find(p=>p.id===id);
function art(f,hex,nome){const dk=parseInt(hex.slice(1,3),16)*.3+parseInt(hex.slice(3,5),16)*.6+parseInt(hex.slice(5,7),16)*.1<140;
 const tx=["to","tb","mo"].includes(f)?`<text x="50" y="${f==="mo"?48:42}" font-size="5.5" font-weight="800" letter-spacing="1" text-anchor="middle" fill="${dk?"#fff":"#111"}" font-family="Syne,sans-serif">VÉRTICE</text>`:"";
 return `<svg viewBox="0 0 100 120" role="img" aria-label="${nome}" preserveAspectRatio="xMidYMid meet"><path d="${SH[f]}" fill="${hex}" stroke="rgba(0,0,0,.35)" stroke-width="1" stroke-linejoin="round"/>${DT[f]?`<path d="${DT[f]}" fill="none" stroke="rgba(${dk?"255,255,255":"0,0,0"},.35)" stroke-width="1"/>`:""}${tx}</svg>`}
const $=s=>document.querySelector(s);
function card(p){const price=p.promo?`<s>${R(p.preco)}</s>${R(p.promo)}`:R(p.preco);
 return `<button class="card" data-p="${p.id}"><div class="im">${art(p.f,C[p.cores[0]].h,p.nome)}${p.novo?'<span class="tag">Novo</span>':""}${p.promo?`<span class="tag p">-${Math.round(100-p.promo/p.preco*100)}%</span>`:""}</div><h3>${p.nome}</h3><div class="pr">${price}</div><div class="dots">${p.cores.map(c=>`<i style="background:${C[c].h}" title="${C[c].n}"></i>`).join("")}</div></button>`}
let cart=[];try{cart=JSON.parse(localStorage.getItem("vx_bag")||"[]").filter(i=>byId(i.id))}catch(e){}
const bag=()=>{try{localStorage.setItem("vx_bag",JSON.stringify(cart))}catch(e){}};
const sub=()=>cart.reduce((s,i)=>s+pp(byId(i.id))*i.q,0);
function fill(sel,first,vals){$(sel).innerHTML=`<option value="">${first}</option>`+vals.map(v=>`<option>${v}</option>`).join("")}
fill("#fc","Categoria",CATS);fill("#ft","Tamanho",[...T,...N,"Único"]);
$("#fk").innerHTML='<option value="">Cor</option>'+Object.keys(C).map(k=>`<option value="${k}">${C[k].n}</option>`).join("");
function loja(){
 const q=$("#fq").value.trim().toLowerCase(),c=$("#fc").value,t=$("#ft").value,k=$("#fk").value,pr=$("#fp").value,o=$("#fo").value;
 let l=D.filter(p=>(!q||p.nome.toLowerCase().includes(q))&&(!c||p.cat===c)&&(!t||p.tams.includes(t))&&(!k||p.cores.includes(k))&&(!pr||(pp(p)>=+pr.split("-")[0]&&pp(p)<+pr.split("-")[1])));
 if(o==="a")l.sort((a,b)=>pp(a)-pp(b));if(o==="d")l.sort((a,b)=>pp(b)-pp(a));if(o==="n")l.sort((a,b)=>b.novo-a.novo||b.id-a.id);
 $("#gLoja").innerHTML=l.map(card).join("");$("#none").hidden=l.length>0}
function go(v){["#fq","#fc","#ft","#fk","#fp","#fo"].forEach(s=>$(s).value="");if(v==="novo")$("#fo").value="n";else if(v)$("#fc").value=v;loja();$("#loja").scrollIntoView()}
$("#gNovo").innerHTML=D.filter(p=>p.novo).slice(0,4).map(card).join("");
$("#gTop").innerHTML=D.filter(p=>p.top).slice(0,4).map(card).join("");
$("#cats").innerHTML=CATS.map(c=>`<button class="cat" data-go="${c}">${c}<small>${D.filter(p=>p.cat===c).length} peças</small></button>`).join("");
$("#heroArt").innerHTML=art("mo","#f2f2ef","");$("#featArt").innerHTML=art("mo","#3a3a3a","Moletom Eixo");
["#fq","#fc","#ft","#fk","#fp","#fo"].forEach(s=>$(s).addEventListener("input",loja));
$("#clr").onclick=()=>go("");
$("#q").addEventListener("input",e=>{$("#fq").value=e.target.value;loja();$("#loja").scrollIntoView()});

let sel={};
function open(id){const p=byId(id);sel={p,t:p.tams.length===1?p.tams[0]:"",c:p.cores.length===1?p.cores[0]:"",q:1};
 $("#pd").innerHTML=`<div class="im" id="pi">${art(p.f,C[p.cores[0]].h,p.nome)}</div><div><h2>${p.nome}</h2><div class="pr" style="font-size:20px">${p.promo?`<s>${R(p.preco)}</s>${R(p.promo)}`:R(p.preco)}</div><p>${p.desc}</p>
 <div class="lb">Tamanho</div><div class="opts">${p.tams.map(t=>`<button class="opt" data-t="${t}" aria-pressed="${sel.t===t}">${t}</button>`).join("")}</div>
 <div class="lb">Cor: <span id="cn">${sel.c?C[sel.c].n:"selecione"}</span></div><div class="opts">${p.cores.map(c=>`<button class="sw" data-c="${c}" aria-label="${C[c].n}" aria-pressed="${sel.c===c}" style="background:${C[c].h}"></button>`).join("")}</div>
 <div class="lb">Quantidade</div><div class="qt"><button data-q="-1" aria-label="Diminuir">−</button><span id="qv">1</span><button data-q="1" aria-label="Aumentar">+</button></div>
 <div class="err" id="pe" role="alert"></div><button class="btn blk" id="addb">Adicionar à sacola</button>
 <div class="info">Entrega para todo o Brasil, com frete grátis acima de R$ 399. Primeira troca grátis em até 30 dias.</div></div>`;
 $("#pm").classList.add("on");$("#ov").classList.add("on")}
function pick(sec,attr,val){document.querySelectorAll(`#pd [data-${attr}]`).forEach(b=>b.setAttribute("aria-pressed",b.dataset[attr]===val))}
function add(){const e=$("#pe");if(!sel.t||!sel.c){e.textContent="Escolha "+(!sel.t&&!sel.c?"o tamanho e a cor":!sel.t?"o tamanho":"a cor")+" para continuar.";return}
 const i=cart.find(x=>x.id===sel.p.id&&x.t===sel.t&&x.c===sel.c);i?i.q+=sel.q:cart.push({id:sel.p.id,t:sel.t,c:sel.c,q:sel.q});render();
 const b=$("#addb");b.textContent="Adicionado à sacola ✓";setTimeout(()=>{if(b)b.textContent="Adicionar à sacola"},1600);toast(sel.p.nome+" foi adicionado à sacola.")}
function toast(m){const t=$("#toast");t.textContent=m;t.classList.add("on");clearTimeout(toast.i);toast.i=setTimeout(()=>t.classList.remove("on"),2200)}
function render(){bag();$("#cnt").textContent=cart.reduce((s,i)=>s+i.q,0);
 if(!cart.length){$("#items").innerHTML='<p class="empty">Sua sacola está vazia. Escolha uma peça para começar.</p>';$("#dfoot").hidden=true;return}
 $("#dfoot").hidden=false;
 $("#items").innerHTML=cart.map((i,n)=>{const p=byId(i.id);return `<div class="it"><div class="im">${art(p.f,C[i.c].h,p.nome)}</div><div><strong>${p.nome}</strong><br><small>${i.t} · ${C[i.c].n}</small><div class="qt"><button data-m="${n}" aria-label="Diminuir">−</button><span>${i.q}</span><button data-a="${n}" aria-label="Aumentar">+</button></div></div><strong>${R(pp(p)*i.q)}</strong><button class="rm" data-r="${n}">Remover</button></div>`}).join("");
 $("#sub").textContent=$("#tot").textContent=R(sub())}
const showBag=()=>{$("#dr").classList.add("on");$("#ov").classList.add("on")};
function closeAll(){["#dr","#ov","#pm","#cm"].forEach(s=>$(s).classList.remove("on"))}
document.addEventListener("click",e=>{const b=e.target.closest("button,a"),d=b?b.dataset:{};if(!b)return;
 if(d.p)open(+d.p);if(d.go!==undefined&&b.tagName==="BUTTON")go(d.go);if("close"in d)closeAll();
 if(d.t){sel.t=d.t;pick(0,"t",d.t);$("#pe").textContent=""}
 if(d.c){sel.c=d.c;pick(0,"c",d.c);$("#cn").textContent=C[d.c].n;$("#pi").innerHTML=art(sel.p.f,C[d.c].h,sel.p.nome);$("#pe").textContent=""}
 if(d.q){sel.q=Math.max(1,sel.q+ +d.q);$("#qv").textContent=sel.q}
 if(d.m){const i=cart[+d.m];if(--i.q<=0)cart.splice(+d.m,1);render()}
 if(d.a){cart[+d.a].q++;render()}if(d.r){cart.splice(+d.r,1);render()}});
$("#pd").addEventListener("click",e=>{if(e.target.id==="addb")add()});
$("#bagBtn").onclick=showBag;$("#xb").onclick=$("#ov").onclick=$("#cont").onclick=closeAll;
$("#burger").onclick=()=>{const o=$("#nav").classList.toggle("on");$("#burger").setAttribute("aria-expanded",o)};$("#nav").onclick=()=>$("#nav").classList.remove("on");
document.addEventListener("keydown",e=>{if(e.key==="Escape")closeAll()});

const entrega=()=>document.querySelector("[name=en]:checked").value;
const frete=()=>entrega()==="r"||sub()>=CONFIG.freteGratisAcima?0:CONFIG.frete;
function resumo(){$("#ad").hidden=entrega()==="r";
 $("#rs").innerHTML=cart.map(i=>{const p=byId(i.id);return `<div class="rl"><div class="im">${art(p.f,C[i.c].h,p.nome)}</div><div><b>${p.nome}</b><small>${i.t} · ${C[i.c].n} · ${i.q}×</small></div><span>${R(pp(p)*i.q)}</span></div>`}).join("");
 $("#k-sub").textContent=R(sub());$("#k-fr").textContent=frete()?R(frete()):"Grátis";$("#k-tot").textContent=R(sub()+frete());
 const f=CONFIG.freteGratisAcima-sub();$("#k-tip").textContent=entrega()==="e"&&f>0?`Faltam ${R(f)} para o frete grátis.`:""}
$("#go").onclick=()=>{closeAll();resumo();$("#msg").innerHTML="";$("#cm").classList.add("on");$("#cm").scrollTop=0};
$("#back").onclick=()=>{closeAll();showBag()};
document.querySelectorAll("[name=en]").forEach(r=>r.onchange=resumo);
$("#cp").oninput=e=>{const d=e.target.value.replace(/\D/g,"").slice(0,8);e.target.value=d.length>5?d.slice(0,5)+"-"+d.slice(5):d};
$("#tl").oninput=e=>{const d=e.target.value.replace(/\D/g,"").slice(0,11);e.target.value=d.length>6?`(${d.slice(0,2)}) ${d.slice(2,d.length>10?7:6)}-${d.slice(d.length>10?7:6)}`:d.length>2?`(${d.slice(0,2)}) ${d.slice(2)}`:d};
document.querySelectorAll("#cm input,#cm textarea").forEach(i=>i.addEventListener("input",()=>{const e=$("#e-"+i.id);if(e)e.textContent=""}));
$("#pay").onclick=async()=>{const v=id=>$(id).value.trim(),ent=entrega()==="e",d=v("#cp").replace(/\D/g,"");
 const er={nm:v("#nm").split(/\s+/).filter(Boolean).length<2?"Informe nome e sobrenome.":"",em:/^\S+@\S+\.\S+$/.test(v("#em"))?"":"Informe um e-mail válido.",tl:v("#tl").replace(/\D/g,"").length<10?"Informe um telefone com DDD.":"",cp:ent&&d.length!==8?"Informe um CEP com 8 dígitos.":"",ed:ent&&v("#ed").length<5?"Informe o endereço completo.":""};
 Object.keys(er).forEach(k=>$("#e-"+k).textContent=er[k]);const bad=Object.keys(er).find(k=>er[k]);if(bad){$("#"+bad).focus();return}
 if(!cart.length)return;
 if(!CONFIG.pagamentoAtivo){$("#msg").innerHTML='<div class="ok"><b>Demonstração:</b> o pagamento está desativado, então nenhum pedido foi criado nem cobrado. Na loja real, o site envia ao servidor só os códigos das peças e as quantidades; o servidor recalcula os valores e abre o checkout do Mercado Pago.</div>';return}
 const r=await fetch(CONFIG.endpoint,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({itens:cart.map(({id,t,c,q})=>({id,t,c,q})),cliente:{nome:v("#nm"),email:v("#em"),tel:v("#tl"),cep:d,endereco:v("#ed"),obs:v("#ob"),entrega:entrega()}})});
 const j=await r.json();if(j.url)location.href=j.url};
loja();render();
</script></body></html>
